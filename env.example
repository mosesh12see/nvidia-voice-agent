# Copy this to .env and fill in your values
# cp env.example .env

# NVIDIA NIM API
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# LLM model — swap for any NIM-hosted model
NVIDIA_LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# TTS provider: magpie | cartesia
TTS_PROVIDER=cartesia

# Cartesia TTS fallback (used when TTS_PROVIDER=cartesia)
CARTESIA_API_KEY=your-cartesia-key-here
CARTESIA_VOICE_ID=95856005-0332-41b0-935f-352e296aa0df

# Magpie TTS (used when TTS_PROVIDER=magpie, still in preview)
MAGPIE_VOICE=en-US-1

# Daily.co (add after signup at daily.co)
DAILY_API_KEY=
DAILY_BASE_URL=https://api.daily.co/v1

# Launcher server
LAUNCHER_HOST=127.0.0.1
LAUNCHER_PORT=4579

# Default campaign config to load
DEFAULT_CAMPAIGN=template
